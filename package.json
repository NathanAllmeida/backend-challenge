{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "migration:up": "bun src/infrastructure/database/migrate.ts up",
    "migration:down": "bun src/infrastructure/database/migrate.ts down",
    "queues:setup": "bun src/infrastructure/messaging/setup-queues.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 300000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 120000",
    "test:concurrency": "bun test test/concurrency --timeout 300000"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1150.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.3",
    "typescript": "5.9.3"
  }
}
